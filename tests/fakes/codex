#!/usr/bin/env python3
"""Fake codex executable for tests, driven by FAKE_* env vars."""
import hashlib
import json
import os
import signal
import sys
import time

prompt = "" if os.environ.get("FAKE_NO_READ_STDIN") == "1" else sys.stdin.read()
argv = sys.argv[1:]

print("OpenAI Codex (fake)")
print("user")
print(prompt)
print("codex working")

if "-o" in argv and os.environ.get("FAKE_NO_LAST_MESSAGE") != "1":
    with open(argv[argv.index("-o") + 1], "w") as f:
        f.write(os.environ.get("FAKE_LAST_MESSAGE", "done"))

if os.environ.get("FAKE_TRAP_TERM") == "1":
    def _on_term(signum, frame):
        print("caught SIGTERM", flush=True)
        os._exit(0)

    signal.signal(signal.SIGTERM, _on_term)
elif os.environ.get("FAKE_IGNORE_TERM") == "1":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

time.sleep(float(os.environ.get("FAKE_SLEEP", "0")))

args_file = os.environ.get("FAKE_ARGS_FILE")
if args_file:
    keys = ("GIGACHAD_AGENT_CHILD", "GIGACHAD_LITE_DEPTH", "CLAUDECODE")
    with open(args_file, "w") as f:
        json.dump({"cwd": os.getcwd(), "argv": argv, "env": {k: os.environ.get(k) for k in keys}, "stdin": prompt, "stdin_sha256": hashlib.sha256(prompt.encode()).hexdigest()}, f)

sys.stdout.flush()
sys.exit(int(os.environ.get("FAKE_RC", "0")))
